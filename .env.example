APP_ENV=local
APP_DEBUG=true
DB_URL=mysql+aiomysql://tr_user:tr_password@db:3306/trading
JWT_SECRET=change_me
WEBHOOK_SECRET=change_me
CORS_ORIGINS=http://localhost:5173

OANDA_ENV=practice
OANDA_TOKEN=replace_me
OANDA_ACCOUNT_ID=replace_me

PREDICTION_GATE_ENABLED=true
MC_PATHS=20000
USE_TORCH_MODELS=true

RISK_MAX_PCT_PER_TRADE=0.5
RISK_MIN_SL_PIPS=8
RISK_MAX_SL_PIPS=250
RISK_ATR_PERIOD=14
RISK_ATR_MULT_SL=1.5
RISK_ATR_MULT_TP=3.0
RISK_USE_R_MULT_TP=true
RISK_R_MULT_TP=2.0
RISK_TSL_ENABLE=true
RISK_TSL_ATR_MULT=1.2
RISK_BREAKEVEN_ENABLE=true
RISK_BREAKEVEN_AFTER_R=1.0
RISK_TIME_STOP_ENABLE=true
RISK_TIME_STOP_MIN=120
RISK_MAX_DD_DAY_PCT=3.0
RISK_MAX_OPEN_TRADES=5
RISK_TRADING_WINDOWS=09:00-23:00
RISK_NEWS_BLOCK_ENABLE=false
RISK_SPREAD_MAX_PIPS=35
RISK_SLIPPAGE_MAX_PIPS=20
RISK_FAILSAFE_MODE=block
